    "NSSystemExtensionUsageDescription" : {
      "comment" : "Privacy - System Extension Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يحتاج CleanBrowse إلى تثبيت ملحق نظام لحظر النطاقات غير المرغوب فيها على مستوى DNS.‏"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "CleanBrowse muss eine Systemerweiterung installieren, um unerwünschte Domains auf DNS-Ebene zu blockieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "CleanBrowse needs to install a system extension to block unwanted domains at the DNS level."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "CleanBrowse necesita instalar una extensión del sistema para bloquear dominios no deseados a nivel de DNS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "CleanBrowse doit installer une extension système pour bloquer les domaines indésirables au niveau DNS."
          }
        },
