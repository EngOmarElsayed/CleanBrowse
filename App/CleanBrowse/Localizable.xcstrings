    "Add a domain above, then view or remove your blocked domains anytime." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف نطاقًا في الأعلى، ثم اعرض نطاقاتك المحظورة أو أزلها في أي وقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge oben eine Domain hinzu und sieh dir deine blockierten Domains jederzeit an oder entferne sie."
